{
  "name": "playwright-pacifico",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:results": "node scripts/clean-results.js",
    "pretest": "npm run clean:results",
    "test": "cross-env ENV=dev BROWSER=chromium HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:dev": "npm run clean:results",
    "test:dev": "cross-env ENV=dev BROWSER=chrome HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:uat": "npm run clean:results",
    "test:uat": "cross-env ENV=uat BROWSER=chrome HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:ci": "npm run clean:results",
    "test:ci": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:dev:chrome": "npm run clean:results",
    "test:dev:chrome": "cross-env ENV=dev BROWSER=chrome HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:dev:firefox": "npm run clean:results",
    "test:dev:firefox": "cross-env ENV=dev BROWSER=firefox HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:dev:webkit": "npm run clean:results",
    "test:dev:webkit": "cross-env ENV=dev BROWSER=webkit HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:uat:chrome": "npm run clean:results",
    "test:uat:chrome": "cross-env ENV=uat BROWSER=chrome HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:uat:firefox": "npm run clean:results",
    "test:uat:firefox": "cross-env ENV=uat BROWSER=firefox HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:uat:webkit": "npm run clean:results",
    "test:uat:webkit": "cross-env ENV=uat BROWSER=webkit HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:firefox": "npm run clean:results",
    "test:firefox": "cross-env ENV=dev BROWSER=firefox HEADLESS=true cucumber-js --config=config/cucumber.js",
    "pretest:webkit": "npm run clean:results",
    "test:webkit": "cross-env ENV=dev BROWSER=webkit HEADLESS=true cucumber-js --config=config/cucumber.js",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "npm audit --audit-level=high",
    "report:cucumber": "node scripts/generate-cucumber-report.mjs",
    "report:allure": "node scripts/normalize-allure-results.js && allure generate allure-results --clean -o test-results/allure-report && node scripts/verify-report-counts.js",
    "verify:secrets": "node scripts/verify-no-secrets.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "multiple-cucumber-html-reporter": "^4.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
